# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Required only when ENABLE_LLM_REASONING=true. Never hardcode this in source.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Turns on the optional AI analyst narrative (backend/app/reasoning/llm_analyst.py).
# Off by default so the app and pytest suite stay fully offline/deterministic.
ENABLE_LLM_REASONING=false

# Overrides the model used for the analyst narrative.
ANTHROPIC_MODEL=claude-haiku-4-5

# SQLAlchemy database URL. Defaults to a local SQLite file so the app and pytest suite run
# with zero setup. Point this at the docker-compose Postgres for a real deployment, e.g.:
#   DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
DATABASE_URL=sqlite:///./aegis.db

# Signs/verifies JWT access tokens (M8 Stage 2 auth). If unset, a random secret is generated
# per-process — fine for local dev, but every restart invalidates all sessions. Production
# MUST set a real, stable value: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# How long an access token stays valid before a refresh is required.
JWT_ACCESS_TOKEN_TTL_MINUTES=15
# How long a refresh token stays valid (server-side revocable — see app.auth.security).
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Email forwarding intake (M8 Stage 3). Mailgun's HTTP webhook signing key (Sending ->
# Webhooks in the Mailgun dashboard — a different value from the API key). Required for
# POST /api/inbound/email/mime to accept anything at all; unset means it hard-rejects
# every request (503) rather than silently accepting unsigned ones. See DEPLOYMENT.md.
MAILGUN_WEBHOOK_SIGNING_KEY=
# Must match the domain your Mailgun receiving route is configured on. Shown to users as
# pilot-<token>@<this>.
INBOUND_EMAIL_DOMAIN=in.aegis.example.com
# Replay-attack defense in depth for the inbound webhook — Mailgun's signature never
# expires on its own.
INBOUND_EMAIL_SIGNATURE_MAX_AGE_SECONDS=900
# Per-account cap on inbound-forwarded emails per hour.
INBOUND_EMAIL_RATE_LIMIT_PER_ACCOUNT_PER_HOUR=30

# Real Microsoft Graph autonomous-response connector (M6 Stage 2) — QUARANTINE_EMAIL/
# DISABLE_SESSION/BLOCK_SENDER_DOMAIN actually acting on a connected Microsoft 365 tenant,
# via app.autonomy.graph_connector. One multi-tenant Azure AD app registration shared across
# every account (each customer's admin consents it into their own tenant separately; the
# per-account tenant_id lives in the graph_integrations table, not here). Unrelated to the
# older MS_GRAPH_* vars below (an unimplemented, single-tenant Teams-ingestion seam) — leave
# unset and every account safely falls back to MockConnector, no real action ever fires.
# See DEPLOYMENT.md for the full Azure app registration walkthrough.
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=

# Directory where raw .eml uploads are stored on disk. The `cases` table stores only a
# pointer to this path — never the raw email itself (data minimization).
RAW_EMAIL_STORAGE_DIR=./data/raw_emails

# How many days a raw .eml is kept on disk before being purged. Purge runs best-effort at
# backend startup; you can also run it on a schedule (cron/systemd timer).
RAW_EMAIL_RETENTION_DAYS=30

# Directory where generated Audit Mode evidence-pack PDF/JSON files are stored on disk.
AUDIT_REPORT_STORAGE_DIR=./data/audit_reports

# A recipient hit by this many non-safe cases gets flagged for a stored micro-training
# recommendation (GET /api/targets). No LMS integration — just the stored recommendation.
TARGET_TRAINING_THRESHOLD=3

# Turns on POST /api/copilot/query, the natural-language threat copilot. Separate from
# ENABLE_LLM_REASONING since it's a broader, cross-case data-access surface. Requires
# ANTHROPIC_API_KEY. Off by default so the app and pytest suite stay fully offline.
ENABLE_COPILOT=false

# Comma-separated display names protected against chat impersonation (IMPERSONATED_DISPLAY_NAME
# indicator) — e.g. your CEO/CFO/IT-support display names. Empty by default.
CHAT_PROTECTED_DISPLAY_NAMES=

# Live Slack/Teams message ingestion is NOT implemented yet (see app/channels/slack_client.py
# and teams_client.py) — these flags are the seam for when it is. Off by default.
ENABLE_LIVE_SLACK_INGESTION=false
ENABLE_LIVE_TEAMS_INGESTION=false

# Required only when ENABLE_LIVE_SLACK_INGESTION=true. Read-only scopes
# (channels:history/groups:history/im:history/users:read/users:read.email). Never hardcode.
SLACK_BOT_TOKEN=your-slack-bot-token-here
SLACK_SIGNING_SECRET=your-slack-signing-secret-here

# Required only when ENABLE_LIVE_TEAMS_INGESTION=true. Microsoft Graph app registration with
# the read-only ChannelMessage.Read.All/Chat.Read.All application permission. Never hardcode.
MS_GRAPH_CLIENT_ID=your-ms-graph-client-id-here
MS_GRAPH_CLIENT_SECRET=your-ms-graph-client-secret-here
MS_GRAPH_TENANT_ID=your-ms-graph-tenant-id-here

# Authorized phishing-simulation campaigns (M9 Stage 1) — POST /api/sim/campaigns/{id}/send.
# Off by default so the app and pytest suite stay fully offline. Even when on, sending
# degrades to a dry run (no real email) unless MAILGUN_API_KEY and SIMULATION_SENDING_DOMAIN
# are both set below — a campaign can never accidentally reach a real mailbox from an
# unconfigured deployment.
ENABLE_PHISHING_SIMULATION=false
# Mailgun's API key (distinct from MAILGUN_WEBHOOK_SIGNING_KEY above, which is only for
# verifying inbound webhooks). Never hardcode this.
MAILGUN_API_KEY=
MAILGUN_API_BASE_URL=https://api.mailgun.net/v3
MAILGUN_SEND_TIMEOUT_SECONDS=15
# A domain Cordon itself owns and has registered in Mailgun. Simulation email is ALWAYS sent
# from here, never from a customer's own domain — sending from the customer's domain would
# be spoofing their real senders, not simulating a third-party attacker.
SIMULATION_SENDING_DOMAIN=
# Public base URL recipients' browsers hit for GET /api/sim/track/{token}. Required for any
# non-dry-run send — see app.api.routes.simulation.send_campaign.
SIMULATION_TRACKING_BASE_URL=
# DNS-over-HTTPS resolver used to check a domain-verification TXT record
# (app.simulation.dns_check) — httpx-based so it stays respx-mockable in tests rather than
# needing a raw-socket DNS library.
SIMULATION_DNS_OVER_HTTPS_URL=https://cloudflare-dns.com/dns-query
